# Create a key at https://pulse.evorozen.com and keep it server-side.
EVOROZEN_API_KEY=

# The documented Neural Pulse endpoint. Override only for testing.
EVOROZEN_API_URL=https://pulse.evorozen.com/api/neural

# Set to true only after `npm run neural:bootstrap` succeeds. This avoids
# repeating LivingDNA registration on production cold starts.
EVOROZEN_SCHEMA_READY=false

# Optional: makes generated canonical links accurate in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
